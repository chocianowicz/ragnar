OLLAMA_BASE_URL=http://host.docker.internal:11434
QDRANT_URL=http://qdrant:6333

# Optional. Silences the "unauthenticated requests to the HF Hub" warning
# and raises rate limits when downloading the reranker model. Create a free
# read-only token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Eval only (eval/run_ragas.py); the app never reads these. Defaults judge
# with glm-5.3:cloud through the local Ollama above. A ':cloud' model runs
# remotely, so cases touching private golden-set documents are never sent.
# RAGAS_JUDGE_MODEL=glm-5.3:cloud
# RAGAS_JUDGE_BASE_URL=http://host.docker.internal:11434/v1
# RAGAS_JUDGE_API_KEY=ollama
