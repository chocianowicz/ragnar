OLLAMA_BASE_URL=http://host.docker.internal:11434
QDRANT_URL=http://qdrant:6333

# host_server.py, running natively on the Mac so Docling and the cross-encoder
# can use the GPU that Docker on macOS cannot reach. Start it with
# `.venv/bin/python host_server.py` from the repo root on the host.
#
# Both default to this in docker-compose.yml, and both are safe to leave
# unset: the app falls back to in-process CPU parsing and reranking whenever
# the host service is unreachable, so it never breaks, only slows down.
# Set either to an empty value to disable that workload's remote path even
# when host_server.py is running.
# PARSER_URL=http://host.docker.internal:8007
# RERANKER_URL=http://host.docker.internal:8007

# Optional. Silences the "unauthenticated requests to the HF Hub" warning
# and raises rate limits when downloading the reranker model. Create a free
# read-only token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Eval only (eval/run_ragas.py); the app never reads these. Defaults judge
# with glm-5.3:cloud through the local Ollama above. A ':cloud' model runs
# remotely, so cases touching private golden-set documents are never sent.
# RAGAS_JUDGE_MODEL=glm-5.3:cloud
# RAGAS_JUDGE_BASE_URL=http://host.docker.internal:11434/v1
# RAGAS_JUDGE_API_KEY=ollama
