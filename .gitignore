.worktrees/

# macOS
.DS_Store

# python
__pycache__/
*.pyc
# No trailing slash: a trailing slash matches only a directory, so a
# *symlink* named .venv (e.g. one pointing at another worktree's venv)
# slipped past this once and was committed with a hardcoded absolute path
# in it.
.venv
.pytest_cache/
dist/
build/
*.egg-info/

# runtime data
data/
.env

# eval reports can contain full chunk text from whatever corpus was
# evaluated - never commit real document content
eval/reports/

# Hard links to data/originals, published so citations can open the real
# file in the browser. Rebuilt on demand; never source.
ui/static/

# Admin settings tuned on a running instance, layered over config.yaml.
# Deployment state, not source.
data/settings.json

# Page snapshots a browser-automation tool drops in the repo root.
.playwright-mcp/
